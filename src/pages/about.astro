---
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import Bloques from "@/components/Bloques.astro";
import { getSections, type Seccion } from "@/lib/aboutPage";
const data = await getSections();
---

<Base title="About">
  <section class="section">
    <div class="container">
      {data?.Seccion?.map((seccion: Seccion) => {
        switch (seccion.__component) {
          case "componentes.tarjeta":
            return <Card {...seccion} />;
          case "componentes.bloques":
            return <Bloques {...seccion} />;
          default:
            return null;
        }
      })}
    </div>
  </section>
</Base>

