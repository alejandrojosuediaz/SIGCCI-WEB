---
import Empresas from "@/components/Empresas.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getEmpresas } from "@/lib/empresas";

const empresas = await getEmpresas();
const totalPages = Math.ceil(empresas.length / config.settings.pagination);
const currentEmpresas = empresas.slice(0, config.settings.pagination);
---

<Base title={"Empresas"}>
  <section class="section">
    <div class="container">
      <h1 class="page-heading h2">Empresas</h1>
      <Empresas empresas={currentEmpresas} />
      <Pagination
        section={"empresas"}
        currentPage={1}
        totalPages={totalPages}
      />
    </div>
  </section>
</Base>
