---
import Filials from "@/components/Filials.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import { getFilials } from "@/lib/filials";

export async function getStaticPaths() {
  const filials = await getFilials();
  const totalPages = Math.ceil(filials.length / config.settings.pagination);
  const paths = [];

  for (let page = 2; page <= totalPages; page++) {
    paths.push({ params: { slug: page.toString() } });
  }

  return paths;
}

const { slug } = Astro.params;
const filials = await getFilials();
const totalPages = Math.ceil(filials.length / config.settings.pagination);
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastFilial = currentPage * config.settings.pagination;
const indexOfFirstFilial = indexOfLastFilial - config.settings.pagination;
const currentFilials = filials.slice(indexOfFirstFilial, indexOfLastFilial);
---

<Base title={"Filiales"}>
  <section class="section">
    <div class="container text-center">
      <h1 class="page-heading h2">Filiales</h1>
      <Filials filials={currentFilials} />
      <Pagination
        section={"filiales"}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </div>
  </section>
</Base>
