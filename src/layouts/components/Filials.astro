---
import { getFilialId, getFilialLogo, getStrapiAssetUrl, type Filial } from "@/lib/filials";
import { Image } from "astro:assets";
import { BsArrowRightCircle } from "react-icons/bs";

type Props = {
  filials: Filial[];
};

const { filials } = Astro.props;
const strapiUrl = import.meta.env.PUBLIC_STRAPI_URL ?? "http://localhost:1337";
---

<div class="row justify-center">
  {
    filials.map((filial) => {
      const title = filial.Filial ?? "Filial";
      const logo = getStrapiAssetUrl(getFilialLogo(filial), strapiUrl);
      const id = getFilialId(filial);

      return (
        <div class="col-12 mb-8 sm:col-6 md:col-4">
          {logo && (
            <div class="mb-4">
              <Image
                src={logo}
                alt={title}
                height={150}
                width={150}
                class="mx-auto h-[150px] w-[150px] rounded-lg object-contain"
              />
            </div>
          )}
          <h3 class="h4 mt-8 mb-3">
            <a
              href={`/filiales/${id}`}
              class="block hover:text-primary transition duration-200"
            >
              {title}
            </a>
          </h3>
          <a
            href={`/filiales/${id}`}
            class="inline-flex items-center text-primary transition duration-200 hover:opacity-70"
          >
            Ver noticias <BsArrowRightCircle className="inline ml-2" />
          </a>
        </div>
      );
    })
  }
</div>
